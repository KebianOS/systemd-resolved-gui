#: src/systemd_resolved_gui/app.py:37 src/systemd_resolved_gui/app.py:270
msgid "systemd-resolved Editor"
msgstr "Éditeur de systemd-resolved"

#: src/systemd_resolved_gui/app.py:68
#, python-format
msgid "Could not create the restore point; Save and Restore are disabled: %s"
msgstr ""
"Impossible de créer le point de restauration ; Enregistrer et Restaurer sont "
"désactivés : %s"

#: src/systemd_resolved_gui/app.py:112
msgid "Reload"
msgstr "Recharger"

#: src/systemd_resolved_gui/app.py:116 src/systemd_resolved_gui/app.py:341
msgid "Save"
msgstr "Enregistrer"

#: src/systemd_resolved_gui/app.py:120
msgid "Restore original"
msgstr "Restaurer l’original"

#: src/systemd_resolved_gui/app.py:196
msgid "The restore point metadata is invalid."
msgstr "Les métadonnées du point de restauration sont invalides."

#: src/systemd_resolved_gui/app.py:198
msgid "The original snapshot file is missing."
msgstr "Le fichier de sauvegarde initiale est manquant."

#: src/systemd_resolved_gui/app.py:204
#, python-format
msgid "An incomplete restore point exists at %s; refusing to overwrite it."
msgstr ""
"Un point de restauration incomplet existe dans %s ; il ne sera pas écrasé."

#: src/systemd_resolved_gui/app.py:209
#, python-format
msgid "%s is a symbolic link; editing stopped for safety."
msgstr ""
"%s est un lien symbolique ; la modification a été arrêtée par sécurité."

#: src/systemd_resolved_gui/app.py:247
msgid "The configuration file is a symbolic link."
msgstr "Le fichier de configuration est un lien symbolique."

#: src/systemd_resolved_gui/app.py:251
msgid "Configuration loaded."
msgstr "Configuration chargée."

#: src/systemd_resolved_gui/app.py:255
msgid "The configuration file does not exist; showing a template."
msgstr "Le fichier de configuration n’existe pas ; un modèle est affiché."

#: src/systemd_resolved_gui/app.py:258
#, python-format
msgid "Could not read the configuration: %s"
msgstr "Impossible de lire la configuration : %s"

#: src/systemd_resolved_gui/app.py:276
msgid "There are unsaved changes."
msgstr "Des modifications ne sont pas enregistrées."

#: src/systemd_resolved_gui/app.py:287
msgid "Cancel"
msgstr "Annuler"

#: src/systemd_resolved_gui/app.py:297
msgid "There are unsaved changes"
msgstr "Des modifications ne sont pas enregistrées"

#: src/systemd_resolved_gui/app.py:298
msgid "Continuing will discard the edits in this window."
msgstr ""
"Si vous continuez, les modifications de cette fenêtre seront abandonnées."

#: src/systemd_resolved_gui/app.py:299
msgid "Discard changes"
msgstr "Abandonner les modifications"

#: src/systemd_resolved_gui/app.py:305
msgid "pkexec was not found on this system."
msgstr "pkexec est introuvable sur ce système."

#: src/systemd_resolved_gui/app.py:316
msgid "The operation was cancelled or denied."
msgstr "L’opération a été annulée ou refusée."

#: src/systemd_resolved_gui/app.py:322
msgid "The systemctl utility was not found."
msgstr "L’utilitaire systemctl est introuvable."

#: src/systemd_resolved_gui/app.py:333
msgid "Cannot save: the original restore point is unavailable."
msgstr ""
"Enregistrement impossible : le point de restauration initial est "
"indisponible."

#: src/systemd_resolved_gui/app.py:336
msgid "Save the system configuration"
msgstr "Enregistrer la configuration du système"

#: src/systemd_resolved_gui/app.py:338
#, python-format
msgid ""
"This will replace %s. The initial state will be kept so you can restore it."
msgstr ""
"Le fichier %s sera remplacé. L’état initial sera conservé pour permettre sa "
"restauration."

#: src/systemd_resolved_gui/app.py:357 src/systemd_resolved_gui/app.py:413
msgid "The install utility was not found."
msgstr "L’utilitaire install est introuvable."

#: src/systemd_resolved_gui/app.py:377
#, python-format
msgid "Configuration saved, but systemd-resolved could not be restarted: %s"
msgstr "Configuration enregistrée, mais impossible de redémarrer systemd-resolved : %s"

#: src/systemd_resolved_gui/app.py:383
msgid "Configuration saved and systemd-resolved restarted."
msgstr "Configuration enregistrée et systemd-resolved redémarré."

#: src/systemd_resolved_gui/app.py:386
#, python-format
msgid "Could not save: %s"
msgstr "Impossible d’enregistrer : %s"

#: src/systemd_resolved_gui/app.py:396
msgid "There is no original restore point."
msgstr "Aucun point de restauration initial n’est disponible."

#: src/systemd_resolved_gui/app.py:399
msgid "Restore the original file"
msgstr "Restaurer le fichier initial"

#: src/systemd_resolved_gui/app.py:401
msgid ""
"Unsaved edits will be discarded and the state captured when this editor was "
"first opened will be restored."
msgstr ""
"Les modifications non enregistrées seront abandonnées et l’état enregistré "
"lors du premier lancement de l’éditeur sera restauré."

#: src/systemd_resolved_gui/app.py:404
msgid "Restore"
msgstr "Restaurer"

#: src/systemd_resolved_gui/app.py:428
msgid "The rm utility was not found."
msgstr "L’utilitaire rm est introuvable."

#: src/systemd_resolved_gui/app.py:437
#, python-format
msgid ""
"Original state restored, but systemd-resolved could not be restarted: %s"
msgstr "État initial restauré, mais impossible de redémarrer systemd-resolved : %s"

#: src/systemd_resolved_gui/app.py:443
msgid "Original state restored and systemd-resolved restarted."
msgstr "État initial restauré et systemd-resolved redémarré."

#: src/systemd_resolved_gui/app.py:446
#, python-format
msgid "Could not restore: %s"
msgstr "Impossible de restaurer : %s"

#, python-format
#~ msgid "Saved successfully to %s."
#~ msgstr "Enregistré correctement dans %s."

#~ msgid "The original state was restored."
#~ msgstr "L’état initial a été restauré."
